{
  "name": "@aotterclam/agent-bridge",
  "version": "0.1.3",
  "description": "Local OpenAI-compatible bridge for official coding-agent runtimes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AotterClam/agent-bridge.git"
  },
  "bugs": "https://github.com/AotterClam/agent-bridge/issues",
  "engines": {
    "bun": ">=1.3.0"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "bin": {
    "agent-bridge": "src/cli.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "26.1.2",
    "typescript": "6.0.3"
  }
}
